or('period must be daily, weekly or monthly')
    return start.isoformat(), end.isoformat()


class Journal:
    """Explicit path; no network, credentials, market data, or broker commands."""
    def __init__(self, path):
        self.db = sqlite3.connect(str(path), timeout=5)
        self.db.row_factory = sqlite3.Row
        try:
            self.db.execute('PRAGMA foreign_keys=ON')
            self.db.execute('PRAGMA synchronous=FULL')
            version = self.db.execute('PRAGMA user_version').fetchone()[0]
            if version not in (0, SCHEMA_VERSION):
                raise ValueError('Unsupported journal schema version')
            if version == 0:
                # Reject unrelated SQLite databases rather than claiming them as a journal.
                if self.db.execute("SELECT 1 FROM sqlite_master WHERE type='table' AND name NOT LIKE 'sqlite_%' LIMIT 1").fetchone():
                    raise ValueError('Not an empty or recognized journal database')
                with self.db:
                    self.db.execute('''CREATE TABLE trades (
                        id INTEGER PRIMARY KEY, opened_date TEXT NOT NULL, closed_date TEXT,
                        symbol TEXT NOT NULL, direction TEXT NOT NULL, currency TEXT NOT NULL,
                        realized_pnl TEXT, planned_risk TEXT, strategy TEXT NOT NULL, notes TEXT NOT NULL)''')
                    self.db.execute('''CREATE TABLE reviews (
                        period TEXT NOT NULL, start_date TEXT NOT NULL, end_date TEXT NOT NULL,
                        notes TEXT NOT NULL, PRIMARY KEY(period,start_date))''')
                    self.db.execute(f'PRAGMA user_version={SCHEMA_VERSION}')
            # Recognition: version alone is not sufficient.
            self.db.execute('SELECT id, opened_date, closed_date, symbol, direction, currency, realized_pnl, planned_risk, strategy, notes FROM trades LIMIT 0')
            self.db.execute('SELECT period, start_date, end_date, notes FROM reviews LIMIT 0')
        except Exception:
            self.db.close()
            raise

    def close(self):
        self.db.close()

    def __enter__(self):
        return self

    def __exit__(self, *_):
        self.close()

    def add_trade(self, data):
        trade = validate_trade(data)
        cols = ', '.join(trade)
        with self.db:
            cursor = self.db.execute(f'INSERT INTO trades ({cols}) VALUES ({", ".join("?" for _ in trade)})', tuple(trade.values()))
        return cursor.lastrowid

    def replace_trade(self, trade_id, data):
        if type(trade_id) is not int or trade_id < 1:
            raise ValueError('trade_id must be a positive integer')
        trade = validate_trade(data)
        with self.db:
            result = self.db.execute('UPDATE trades SET ' + ', '.join(k + '=?' for k in trade) + ' WHERE id=?', (*trade.values(), trade_id))
            if result.rowcount != 1:
                raise ValueError('trade not found')

    def get_trade(self, trade_id):
        if type(trade_id) is not int or trade_id < 1:
            raise ValueError('trade_id must be a positive integer')
        row = self.db.execute('SELECT * FROM trades WHERE id=?', (trade_id,)).fetchone()
        if row is None:
            raise ValueError('trade not found')
        return dict(row)

    def list_trades(self):
        return [dict(r) for r in self.db.execute('SELECT * FROM trades ORDER BY opened_date, id')]

    def save_review(self, period, date, notes):
        start, end = period_bounds(period, date)
        notes = _text(notes, 'notes', 20000)
        with self.db:
            self.db.execute('''INSERT INTO reviews(period,start_date,end_date,notes) VALUES (?,?,?,?)
                ON CONFLICT(period,start_date) DO UPDATE SET end_date=excluded.end_date, notes=excluded.notes''',
                (period, start, end, notes))

    def review(self, period, date):
